# Host clients; Compose train uses http://mlflow:5000 on vision-mlflow.
MLFLOW_TRACKING_URI=http://localhost:50001
# Optional override; otherwise the experiment uses data.name (MNIST, PCB, ...).
# MLFLOW_EXPERIMENT_NAME=my_experiment

# Host ownership for services writing dataset metadata to the checkout.
LOCAL_UID=1000
LOCAL_GID=1000
# Default local DVC remote; may be any accessible host folder.
# DVC_LOCAL_REMOTE_DIR=/absolute/path/to/dataset-store
# DVC_REMOTE_NAME=local
# For SSH/S3, select the corresponding Hydra preset and supply a credential-free URL.
# DVC_REMOTE_URL=ssh://user@host/path/to/dataset-store
# DVC_REMOTE_URL=s3://bucket/dataset-store
# Git author/committer may instead be configured in the repository's local Git config.
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
# GIT_COMMITTER_NAME=Your Name
# GIT_COMMITTER_EMAIL=you@example.com
